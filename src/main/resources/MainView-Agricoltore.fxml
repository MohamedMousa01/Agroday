<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.grafico.gui.MainGUIController"
            prefHeight="700" prefWidth="900"
            style="-fx-background-color: linear-gradient(to bottom right, #6a11cb, #2575fc);">

    <!-- TOP - Header -->
    <top>
        <VBox style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="🌾 AGRODAY - Pannello Agricoltore" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6a11cb;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="welcomeLabel" text="Benvenuto!" 
                       style="-fx-font-size: 16px; -fx-text-fill: #333;"/>
            </HBox>
            <Separator style="-fx-padding: 10 0 0 0;"/>
        </VBox>
    </top>

    <!-- CENTER - Main Content -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 20;">
                
                <!-- Card Container -->
                <GridPane hgap="15" vgap="15" alignment="CENTER">
                
                <!-- Card 1: Crea Annuncio -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="0" GridPane.rowIndex="0" prefWidth="250" prefHeight="160">
                    <Label text="📝" style="-fx-font-size: 36px;"/>
                    <Label text="Crea Nuovo Annuncio" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Pubblica i tuoi prodotti" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="creaAnnuncioButton" text="Crea" onAction="#showCreaAnnuncio"
                            style="-fx-background-color: #6a11cb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 2: Cerca Annunci -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250" prefHeight="160">
                    <Label text="🔍" style="-fx-font-size: 36px;"/>
                    <Label text="Cerca Annunci" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Trova altri prodotti agricoli" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="cercaAnnunciButton" text="Cerca" onAction="#showCercaAnnunci"
                            style="-fx-background-color: #6a11cb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 3: I Miei Annunci -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="0" GridPane.rowIndex="1" prefWidth="250" prefHeight="160">
                    <Label text="📋" style="-fx-font-size: 36px;"/>
                    <Label text="I Miei Annunci" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Gestisci i tuoi annunci pubblicati" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="mieiAnnunciButton" text="Visualizza" onAction="#showMieiAnnunci"
                            style="-fx-background-color: #6a11cb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 4: Chiedi Consulenza -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250" prefHeight="160">
                    <Label text="💬" style="-fx-font-size: 36px;"/>
                    <Label text="Chiedi Consulenza" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Richiedi una consulenza specializzata" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="consulenzaButton" text="Richiedi" onAction="#showChiediConsulenza"
                            style="-fx-background-color: #6a11cb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 5: Le Mie Partecipazioni -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="0" GridPane.rowIndex="2" prefWidth="250" prefHeight="160">
                    <Label text="🤝" style="-fx-font-size: 36px;"/>
                    <Label text="Le Mie Partecipazioni" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Annunci di gruppo a cui hai partecipato" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="miePartecipazioniButton" text="Visualizza" onAction="#showMiePartecipazioni"
                            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 6: Offerte Ricevute -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250" prefHeight="160">
                    <Label text="💰" style="-fx-font-size: 36px;"/>
                    <Label text="Offerte Ricevute" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Vedi le offerte dai venditori" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Visualizza" onAction="#showOfferteRicevute"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 7: Le Mie Consulenze -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="0" GridPane.rowIndex="3" prefWidth="250" prefHeight="160">
                    <Label text="📅" style="-fx-font-size: 36px;"/>
                    <Label text="Le Mie Consulenze" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Visualizza e gestisci i tuoi appuntamenti" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Visualizza" onAction="#showListaAppuntamenti"
                            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                <!-- Card 8: Profilo -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);" 
                      GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="250" prefHeight="160">
                    <Label text="👤" style="-fx-font-size: 36px;"/>
                    <Label text="Il Mio Profilo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Label text="Visualizza e modifica il tuo profilo" wrapText="true" style="-fx-text-fill: #666;"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Profilo" onAction="#visualizzaProfilo"
                            style="-fx-background-color: #6a11cb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"
                            prefWidth="200"/>
                </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

    <!-- BOTTOM - Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 15;">
            <Button fx:id="logoutButton" text="🚪 Logout" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 30;"/>
        </HBox>
    </bottom>

</BorderPane>