<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.grafico.gui.VisualizzaAnnunciGUIController"
            style="-fx-background-color: linear-gradient(to bottom right, #43e97b, #38f9d7);">

    <!-- TOP - Header -->
    <top>
        <VBox style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="📦 Tutti gli Annunci" 
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Search Box -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <TextField fx:id="txtRicerca" promptText="🔍 Cerca annunci..." 
                               style="-fx-background-radius: 20; -fx-padding: 10 15;" 
                               prefWidth="250"/>
                    <Button fx:id="btnCerca" text="Cerca" onAction="#cercaAnnunci"
                            style="-fx-background-color: #43e97b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 8 20;"/>
                </HBox>
                
                <Button fx:id="btnIndietro" text="← Indietro" onAction="#tornaIndietro"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 8 20;"/>
            </HBox>
            <Separator style="-fx-padding: 10 0 0 0;"/>
        </VBox>
    </top>

    <!-- CENTER - Annunci List -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            
            <!-- Info Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 10; -fx-padding: 15;">
                <Label fx:id="lblNumAnnunci" text="Caricamento annunci..." 
                       style="-fx-font-size: 14px; -fx-text-fill: #333;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAggiorna" text="🔄 Aggiorna" onAction="#aggiornaLista"
                        style="-fx-background-color: transparent; -fx-text-fill: #43e97b; -fx-font-weight: bold;"/>
            </HBox>

            <!-- ScrollPane with ListView -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="vboxAnnunci" spacing="15" style="-fx-padding: 10;">
                    <!-- Gli annunci verranno caricati dinamicamente qui -->
                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
