<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.grafico.gui.ProfiloGUIController"
            style="-fx-background-color: linear-gradient(to bottom right, #4facfe, #00f2fe);">

    <!-- TOP - Header -->
    <top>
        <VBox style="-fx-background-color: rgba(255, 255, 255, 0.95); -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="👤 Il Mio Profilo" 
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4facfe;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnIndietro" text="← Indietro" onAction="#tornaIndietro"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 8 20;"/>
            </HBox>
            <Separator style="-fx-padding: 10 0 0 0;"/>
        </VBox>
    </top>

    <!-- CENTER - Profile Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 40;">
                
                <!-- Profile Card -->
                <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);" 
                      maxWidth="700">
                    
                    <!-- Profile Icon -->
                    <HBox alignment="CENTER">
                        <Label text="👤" style="-fx-font-size: 80px;"/>
                    </HBox>

                    <!-- User Info Grid -->
                    <GridPane hgap="20" vgap="20">
                        
                        <!-- Nome -->
                        <Label text="Nome:" style="-fx-font-weight: bold; -fx-font-size: 14px;" 
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtNome" editable="false" 
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

                        <!-- Cognome -->
                        <Label text="Cognome:" style="-fx-font-weight: bold; -fx-font-size: 14px;" 
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtCognome" editable="false" 
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>

                        <!-- Username -->
                        <Label text="Username:" style="-fx-font-weight: bold; -fx-font-size: 14px;" 
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtUsername" editable="false" 
                                   style="-fx-background-color: #e9ecef; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>

                        <!-- Email -->
                        <Label text="Email:" style="-fx-font-weight: bold; -fx-font-size: 14px;" 
                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="txtEmail" editable="false" 
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"/>

                        <!-- Città -->
                        <Label text="Città:" style="-fx-font-weight: bold; -fx-font-size: 14px;" 
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="txtCitta" editable="false" 
                                   style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>

                        <!-- Tipo Utente -->
                        <Label text="Tipo Utente:" style="-fx-font-weight: bold; -fx-font-size: 14px;" 
                               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <TextField fx:id="txtTipoUtente" editable="false" 
                                   style="-fx-background-color: #e9ecef; -fx-border-color: #dee2e6; -fx-border-radius: 5; -fx-padding: 10;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="300"/>

                    </GridPane>

                    <Separator/>

                    <!-- Action Buttons -->
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnModifica" text="✏️ Modifica Profilo" onAction="#modificaProfilo"
                                style="-fx-background-color: #4facfe; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 12 30; -fx-font-size: 14px;"/>
                        <Button fx:id="btnCambiaPassword" text="🔒 Cambia Password" onAction="#cambiaPassword"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 12 30; -fx-font-size: 14px;"/>
                    </HBox>

                </VBox>

                <!-- Statistics Card (se Agricoltore) -->
                <VBox fx:id="vboxStatistiche" spacing="15" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);" 
                      maxWidth="700" visible="false" managed="false">
                    <Label text="📊 Statistiche" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Separator/>
                    <HBox spacing="40" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="5">
                            <Label fx:id="lblNumAnnunci" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4facfe;"/>
                            <Label text="Annunci Pubblicati" style="-fx-text-fill: #666;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5">
                            <Label fx:id="lblNumOrdini" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                            <Label text="Ordini Ricevuti" style="-fx-text-fill: #666;"/>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
