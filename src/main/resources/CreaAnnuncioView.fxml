<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controllers.grafico.gui.CreaAnnuncioGUIController"
      prefHeight="700" prefWidth="1000">

    <!-- ==================== PANNELLO SINISTRO - INFO ==================== -->
    <VBox alignment="CENTER" prefWidth="380" spacing="25"
          style="-fx-background-color: linear-gradient(to bottom, #2d5a27, #4a7c43, #6b9b37);">
        <padding><Insets top="40" right="35" bottom="40" left="35"/></padding>
        
        <!-- Icona -->
        <StackPane>
            <Circle radius="60" fill="white" opacity="0.15"/>
            <Circle radius="50" fill="white" opacity="0.2"/>
            <Label text="📦" style="-fx-font-size: 55px;"/>
        </StackPane>
        
        <!-- Titolo -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="Crea Annuncio" style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font size="32"/></font>
            </Label>
            <Label text="Pubblica la tua richiesta di prodotti agricoli" 
                   style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-style: italic;">
                <font><Font size="15"/></font>
            </Label>
        </VBox>
        
        <!-- Benefici -->
        <VBox spacing="18" style="-fx-padding: 25 0 0 0;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-text-fill: #90EE90; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Raggiungi venditori qualificati" 
                       style="-fx-text-fill: white; -fx-font-size: 14px;" wrapText="true"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-text-fill: #90EE90; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Trova i prodotti di cui hai bisogno" 
                       style="-fx-text-fill: white; -fx-font-size: 14px;" wrapText="true"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-text-fill: #90EE90; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Gestisci le tue richieste in un click" 
                       style="-fx-text-fill: white; -fx-font-size: 14px;" wrapText="true"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✓" style="-fx-text-fill: #90EE90; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Sistema sicuro e affidabile" 
                       style="-fx-text-fill: white; -fx-font-size: 14px;" wrapText="true"/>
            </HBox>
        </VBox>
        
        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>
        
        <!-- Info Box -->
        <VBox spacing="8" 
              style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 18; -fx-background-radius: 12;">
            <Label text="💡 Suggerimento" 
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            <Label text="Fornisci una descrizione dettagliata per ottenere offerte migliori dai venditori" 
                   wrapText="true" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12px;"/>
        </VBox>
    </VBox>

    <!-- ==================== PANNELLO DESTRO - FORM ==================== -->
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" 
                style="-fx-background-color: #f8f9fa; -fx-background: #f8f9fa;"
                HBox.hgrow="ALWAYS">
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f8f9fa;">
            <padding><Insets top="35" right="55" bottom="35" left="55"/></padding>
            
            <!-- Header Form -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Nuovo Annuncio" style="-fx-text-fill: #2d5a27; -fx-font-weight: bold;">
                    <font><Font size="26"/></font>
                </Label>
                <Label text="Compila tutti i campi per pubblicare il tuo annuncio" 
                       style="-fx-text-fill: #6c757d;">
                    <font><Font size="14"/></font>
                </Label>
            </VBox>
            
            <!-- Card Form -->
            <VBox spacing="22" maxWidth="500" 
                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 38;">
                <effect>
                    <DropShadow color="rgba(0,0,0,0.1)" radius="22" offsetY="6"/>
                </effect>
                
                <!-- ===== SEZIONE INFORMAZIONI GENERALI ===== -->
                <VBox spacing="6">
                    <Label text="📋 Informazioni Generali" style="-fx-text-fill: #2d5a27; -fx-font-weight: bold;">
                        <font><Font size="16"/></font>
                    </Label>
                    <Separator style="-fx-background-color: #e9ecef;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Titolo Annuncio" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <TextField fx:id="titoloField" promptText="Es. Cercasi sementi di grano duro"
                               style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Autore" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <TextField fx:id="autoreField" promptText="Il tuo nome o azienda"
                               style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <!-- ===== SEZIONE PRODOTTO ===== -->
                <VBox spacing="6" style="-fx-padding: 12 0 0 0;">
                    <Label text="🌾 Dettagli Prodotto" style="-fx-text-fill: #2d5a27; -fx-font-weight: bold;">
                        <font><Font size="16"/></font>
                    </Label>
                    <Separator style="-fx-background-color: #e9ecef;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Nome Prodotto" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <TextField fx:id="nomeProdottoField" promptText="Es. Grano duro, Fertilizzante NPK..."
                               style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Quantità Richiesta" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <TextField fx:id="quantitaField" promptText="Es. 50 quintali, 100 kg..."
                               style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <!-- ===== SEZIONE LOCALIZZAZIONE E SCADENZA ===== -->
                <VBox spacing="6" style="-fx-padding: 12 0 0 0;">
                    <Label text="📍 Località e Scadenza" style="-fx-text-fill: #2d5a27; -fx-font-weight: bold;">
                        <font><Font size="16"/></font>
                    </Label>
                    <Separator style="-fx-background-color: #e9ecef;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Città" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <TextField fx:id="cittaField" promptText="Es. Roma, Milano..."
                               style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 14; -fx-font-size: 14px;"/>
                </VBox>
                
                <HBox spacing="15">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📅 Data Creazione" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <DatePicker fx:id="dataCreazionePicker" disable="true" prefWidth="Infinity"
                                    style="-fx-background-color: #e9ecef; -fx-background-radius: 10;"/>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📅 Data Scadenza" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        <DatePicker fx:id="dataScadenzaPicker" promptText="Seleziona data" prefWidth="Infinity"
                                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 10;"/>
                    </VBox>
                </HBox>
                
                <!-- ===== SEZIONE DESCRIZIONE ===== -->
                <VBox spacing="6" style="-fx-padding: 12 0 0 0;">
                    <Label text="📝 Descrizione" style="-fx-text-fill: #2d5a27; -fx-font-weight: bold;">
                        <font><Font size="16"/></font>
                    </Label>
                    <Separator style="-fx-background-color: #e9ecef;"/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Descrizione Dettagliata" style="-fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <TextArea fx:id="descrizioneField" 
                              promptText="Descrivi nel dettaglio le caratteristiche del prodotto che stai cercando, eventuali requisiti di qualità, tempi di consegna preferiti..."
                              prefRowCount="5" wrapText="true"
                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-padding: 12; -fx-font-size: 14px;"/>
                </VBox>
                
                <!-- ===== BOTTONI ===== -->
                <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                    <Button text="Annulla" onAction="#annulla"
                            prefWidth="160" prefHeight="48"
                            style="-fx-background-color: #f8f9fa; -fx-text-fill: #495057; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-border-color: #dee2e6; -fx-border-radius: 12; -fx-cursor: hand;"/>
                    
                    <Button text="📦 Pubblica Annuncio" onAction="#creaAnnuncio"
                            prefWidth="200" prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right, #2d5a27, #4a7c43); -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;">
                        <effect><DropShadow color="rgba(45,90,39,0.4)" radius="10" offsetY="4"/></effect>
                    </Button>
                </HBox>
            </VBox>
            
            <!-- Footer Info -->
            <Label text="L'annuncio sarà visibile a tutti i venditori registrati sulla piattaforma" 
                   style="-fx-text-fill: #adb5bd; -fx-font-size: 12px;"/>
        </VBox>
    </ScrollPane>
</HBox>
